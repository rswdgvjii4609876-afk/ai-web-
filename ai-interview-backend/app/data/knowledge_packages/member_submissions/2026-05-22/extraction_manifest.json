      "experiences": [
        {
          "target_position": "人力资源专员",
          "question": "人力资源岗位如何追问招聘漏斗、人才画像和候选人转化率？",
          "answer_points": "回答应覆盖招聘漏斗的关键节点，如简历来源、筛选、邀约、面试、offer、入职；说明每个节点的转化率如何统计，如何定位流失原因；人才画像需要结合岗位能力、行业背景、薪资期望、稳定性和地域意愿，不应只停留在关键词匹配。",
          "reflection": "该题考察候选人是否理解招聘不是简单找人，而是漏斗管理、数据复盘和人才画像沉淀。",
          "company_context": "拼多多/跨境业务 HR 面试场景",
          "ability": "招聘流程理解、数据意识、人才画像、英文沟通",
          "difficulty": "中等",
          "audit_status": "待核验"
        }
