# Single-host preview. Generate .env with: python3 scripts/init_runtime_env.py
# .env is private. Keep it together with the database backup; do not regenerate it.
COMPOSE_PROJECT_NAME=ai-interview
ENV=preview
HTTP_BIND=127.0.0.1
FRONTEND_HTTP_PORT=8080
ADMIN_HTTP_PORT=8081
FRONTEND_URL=http://localhost:8080
BACKEND_CORS_ORIGINS=http://localhost:8080,http://localhost:8081
API_PORT=8001
UVICORN_WORKERS=1
POSTGRES_USER=ai_interview
POSTGRES_PASSWORD=<GENERATE_POSTGRES_PASSWORD>
POSTGRES_DB=ai_interview
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<GENERATE_REDIS_PASSWORD>
SECRET_KEY=<GENERATE_SECRET_KEY>
USER_LLM_CREDENTIAL_SECRET=<GENERATE_LLM_SECRET>
ROOT_ADMIN_EMAIL=owner@example.com
ADMIN_EMAIL=owner@example.com
AUTH_REQUIRE_EMAIL_VERIFICATION=false
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=1
DB_SCHEDULER_POOL_SIZE=1
DB_SCHEDULER_MAX_OVERFLOW=0
CELERY_WORKER_CONCURRENCY=1
CELERY_WORKER_REPLICAS=1
# Preview starts without a server model key. Each user configures their own key.
# Production mode requires a real DEEPSEEK_API_KEY under the existing validator.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
USE_HTTP_PROXY=false
